# ==============================================================================
# FirstPR AI — Environment Configuration
# ==============================================================================

# GitHub Configuration (Optional, increases rate limit from 60 to 5,000 req/hr)
# Never commit real tokens to source control!
GITHUB_TOKEN=

# AI Provider Configuration (Open-Weight Model)
# Supported AI_PROVIDER values: open_weight, dev_fallback
AI_PROVIDER=open_weight

# Open-Weight Model details (Compatible with Groq, Together AI, Ollama, OpenRouter, vLLM)
# Examples:
# For Groq (Ultra-fast Llama 3):
#   MODEL_NAME=llama-3.3-70b-versatile
#   MODEL_BASE_URL=https://api.groq.com/openai/v1
#   MODEL_API_KEY=gsk_...
#
# For Local Ollama:
#   MODEL_NAME=llama3.2
#   MODEL_BASE_URL=http://localhost:11434/v1
#   MODEL_API_KEY=ollama
#
# For OpenRouter:
#   MODEL_NAME=meta-llama/llama-3.3-70b-instruct
#   MODEL_BASE_URL=https://openrouter.ai/api/v1
#   MODEL_API_KEY=sk-or-...
MODEL_NAME=llama-3.3-70b-versatile
MODEL_BASE_URL=https://api.groq.com/openai/v1
MODEL_API_KEY=

# Backend Server Configuration
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
